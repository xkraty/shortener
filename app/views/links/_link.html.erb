<div class="group bg-white border border-slate-200 rounded-xl p-4 shadow-sm hover:shadow-md hover:border-slate-300 transition">
  <div class="flex items-center justify-between gap-3">
    <%= link_to short_path(link.slug),
        class: "font-medium text-slate-900 hover:text-indigo-600 transition flex items-center gap-1.5 min-w-0",
        target: "_blank" do %>
      <span class="truncate"><%= link.short_link %></span>
      <svg class="w-3.5 h-3.5 shrink-0 text-slate-400 group-hover:text-indigo-500"><%= render "icons/external_link" %></svg>
    <% end %>
    <button
      data-controller="clipboard"
      data-clipboard-text="<%= link.short_link %>"
      data-action="clipboard#copy"
      class="shrink-0 text-slate-400 hover:text-indigo-600 transition p-1"
    >
      <svg class="w-4 h-4" data-clipboard-target="icon"><%= render "icons/copy" %></svg>
      <span class="sr-only" data-clipboard-target="text">Copy</span>
    </button>
  </div>

  <div class="mt-1 text-sm text-slate-500 truncate" title="<%= link.original_url %>">
    <%= link.original_url %>
  </div>

  <div class="mt-3 flex items-center gap-4 text-xs text-slate-400">
    <span class="flex items-center gap-1">
      <svg class="w-3.5 h-3.5"><%= render "icons/click" %></svg>
      <%= pluralize(link.clicks, 'click') %>
    </span>
    <span class="flex items-center gap-1">
      <svg class="w-3.5 h-3.5"><%= render "icons/clock" %></svg>
      <%= time_ago_in_words(link.created_at) %> ago
    </span>
  </div>
</div>
