<div id="<%= dom_id(link) %>" class="bg-paper border border-hair rounded-panel p-4 space-y-2 transition-colors hover:border-green">
  <div class="flex items-center justify-between gap-2">
    <%= link_to short_path(link.slug),
        class: "text-green-ink font-medium hover:underline flex items-center gap-2 min-w-0",
        target: "_blank" do %>
      <span class="truncate"><%= link.short_link %></span>
      <svg class="w-4 h-4 shrink-0"><%= render "icons/external_link" %></svg>
    <% end %>
    <button
      data-controller="clipboard"
      data-clipboard-text="<%= link.short_link %>"
      data-action="clipboard#copy"
      class="text-txt-dim hover:text-ink transition-colors shrink-0"
    >
      <svg class="w-4 h-4" data-clipboard-target="icon"><%= render "icons/copy" %></svg>
      <span class="sr-only" data-clipboard-target="text">Copy</span>
    </button>
  </div>

  <div class="text-txt-dim text-sm truncate" title="<%= link.original_url %>">
    <%= link.original_url %>
  </div>

  <div class="flex items-center gap-4 text-xs text-txt-dim pt-1">
    <span class="flex items-center gap-1.5">
      <svg class="w-3.5 h-3.5 opacity-60">
        <%= render "icons/click" %>
      </svg>
      <%= pluralize(link.clicks, 'click') %>
    </span>
    <span class="flex items-center gap-1.5">
      <svg class="w-3.5 h-3.5 opacity-60">
        <%= render "icons/clock" %>
      </svg>
      <%= time_ago_in_words(link.created_at) %> ago
    </span>
  </div>
</div>
