<div class="max-w-xl mx-auto px-4 sm:px-6 py-16 sm:py-24 space-y-10">
  <div class="text-center space-y-3">
    <%= image_tag "logo/mark.svg", alt: "", class: "w-12 h-12 mx-auto mb-2" %>
    <h1 class="text-3xl sm:text-4xl font-display font-semibold text-ink tracking-tight">Make it short.</h1>
    <p class="text-txt-dim max-w-sm mx-auto">
      Paste a long URL, get back a short <%= ENV.fetch("APP_HOST", "localhost:3000") %> link you can share —
      with click tracking, under your own account.
    </p>
  </div>

  <div class="bg-paper-lift border border-hair rounded-panel shadow-board p-5 sm:p-6 space-y-3">
    <div class="flex items-center gap-2.5 px-4 py-3 bg-paper border border-hair rounded-panel text-txt-dim">
      <svg class="w-4 h-4 shrink-0 opacity-60"><%= render "icons/link" %></svg>
      <span class="truncate font-mono text-sm">https://example.com/blog/2026/the-thing-i-wanted-to-share?utm_source=friend&amp;utm_medium=text</span>
    </div>

    <div class="flex justify-center">
      <svg class="w-4 h-4 text-txt-dim/60"><%= render "icons/arrow_down" %></svg>
    </div>

    <div class="flex items-center justify-between gap-2.5 px-4 py-3 bg-green-tint rounded-panel">
      <span class="truncate font-mono text-sm font-medium text-green-ink"><%= ENV.fetch("APP_HOST", "localhost:3000") %>/aZ3kq1</span>
      <span class="shrink-0 flex items-center gap-1 text-xs text-green-ink/70">
        <svg class="w-3.5 h-3.5"><%= render "icons/click" %></svg>
        tracked
      </span>
    </div>
  </div>

  <div class="text-center space-y-3">
    <div class="flex items-center justify-center gap-3">
      <%= link_to "Create account", new_registration_path,
          class: "bg-green hover:bg-green-ink text-on-green font-medium py-3 px-6 rounded-plate transition-colors" %>
      <%= link_to "Sign in", new_session_path,
          class: "bg-paper-lift border border-hair hover:border-green text-ink font-medium py-3 px-6 rounded-plate transition-colors" %>
    </div>
    <p class="text-xs text-txt-dim">
      Anyone can follow a short link — signing in is only needed to create and manage your own.
    </p>
  </div>
</div>
