<div class="max-w-sm mx-auto mt-12 sm:mt-20 px-4">
  <div class="flex justify-center mb-6">
    <%= image_tag "logo/mark.svg", alt: "", class: "w-10 h-10" %>
  </div>
  <h1 class="text-2xl font-display font-semibold text-center text-ink tracking-tight mb-8">Create an account</h1>

  <div class="bg-paper-lift border border-hair rounded-panel shadow-board-sm p-6 sm:p-8">
    <%= form_with model: @user, url: registration_path, class: "space-y-5" do |f| %>
      <% if @user.errors.any? %>
        <div class="bg-red-50 text-red-700 text-sm rounded-panel px-4 py-3">
          <ul class="list-disc list-inside">
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= f.label :email_address, class: "block text-sm text-txt-dim mb-1.5" %>
        <%= f.email_field :email_address, required: true, autofocus: true, autocomplete: "email",
            class: "w-full px-4 py-3 bg-paper border border-hair rounded-panel focus:ring-2 focus:ring-green focus:border-transparent outline-none transition" %>
      </div>

      <div>
        <%= f.label :password, class: "block text-sm text-txt-dim mb-1.5" %>
        <%= f.password_field :password, required: true, autocomplete: "new-password",
            class: "w-full px-4 py-3 bg-paper border border-hair rounded-panel focus:ring-2 focus:ring-green focus:border-transparent outline-none transition" %>
        <p class="text-xs text-txt-dim mt-1.5">At least 12 characters.</p>
      </div>

      <div>
        <%= f.label :password_confirmation, class: "block text-sm text-txt-dim mb-1.5" %>
        <%= f.password_field :password_confirmation, required: true, autocomplete: "new-password",
            class: "w-full px-4 py-3 bg-paper border border-hair rounded-panel focus:ring-2 focus:ring-green focus:border-transparent outline-none transition" %>
      </div>

      <%= f.submit "Register",
          class: "w-full bg-green hover:bg-green-ink text-on-green font-medium py-3.5 px-7 rounded-plate transition-colors cursor-pointer" %>
    <% end %>
  </div>

  <p class="text-center text-sm text-txt-dim mt-6">
    Already have an account? <%= link_to "Sign in", new_session_path, class: "text-green-ink font-medium hover:underline" %>
  </p>
</div>
